{
  "expo": {
    "name": "Helping Hands",
    "slug": "helping-hands",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#CC0000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "edu.ncsu.helpinghands",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Helping Hands needs Bluetooth to connect to your prosthetic hand device.",
        "NSBluetoothPeripheralUsageDescription": "Helping Hands needs Bluetooth to connect to your prosthetic hand device.",
        "NSUserNotificationsUsageDescription": "Helping Hands sends alerts when your hand disconnects, the battery is low, or an update is available."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "edu.ncsu.helpinghands",
      "permissions": [
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#CC0000",
          "sounds": []
        }
      ]
    ]
  }
}
